{
  "name": "dsh-fullstack-team",
  "version": "0.1.0",
  "description": "A full-stack delivery team for DeepSeek Harness — wish-driven development from requirement to launch, with role presets, stage gates, and rework budgets that survive context loss.",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "deepseek-harness",
    "agent-team",
    "fullstack",
    "delivery",
    "workflow",
    "agent-skills",
    "stage-gates",
    "wish-driven"
  ],
  "license": "MIT",
  "author": "jiangnan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiangNanGit/dsh-fullstack-team.git"
  },
  "homepage": "https://github.com/jiangNanGit/dsh-fullstack-team#readme",
  "bugs": {
    "url": "https://github.com/jiangNanGit/dsh-fullstack-team/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-fullstack-team": "scripts/install.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale/*.json",
    "icon.svg",
    "skills",
    "cordis.patch.yml",
    "roles",
    "templates",
    "scripts",
    "presets",
    "docs/*.md",
    "docs/dev/project-standard.md",
    "docs/dev/project-manifest.md",
    "docs/dev/pm-guidance.md",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-rc.5"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm audit:skills && node scripts/check-preset-compat.mjs && pnpm build",
    "prepack": "pnpm build",
    "audit:skills": "node scripts/skill-audit.mjs skills",
    "dsh:install": "node scripts/install.mjs",
    "presets:install": "node scripts/install-presets.mjs",
    "prepare": "node scripts/prepare-build.mjs"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-skill": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "24.10.1",
    "dsh-verify": "0.9.6",
    "tsdown": "0.22.14",
    "typescript": "5.9.3",
    "unrun": "^0.3.1",
    "vitest": "4.1.8"
  },
  "packageManager": "pnpm@11.28.5"
}
